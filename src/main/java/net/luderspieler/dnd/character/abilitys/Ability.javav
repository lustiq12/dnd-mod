        // Elf
        FEY_ANCESTRY, KEEN_SENSES, TRANCE, ELVEN_LINEAGE,
        // Gnome
        GNOME_CUNNING, GNOMISH_LINEAGE,
        // Goliath
        GIANT_ANCESTRY, LARGE_FORM, POWERFUL_BUILD,
        // Halfling
        BRAVE, HALFLING_NIMBLENESS, LUCKY, NATURALLY_STEALTHY,
        // Human
        RESOURCEFUL, SKILL_VERSATILITY,
        // Orc
        ADRENALINE_RUSH, RELENTLESS_ENDURANCE,
        // Tiefling
        FIENDISH_RESILIENCE_TIEFLING, FIENDISH_LEGACY
    }

    // ==========================================
