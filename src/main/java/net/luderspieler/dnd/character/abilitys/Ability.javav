    public enum RaceAbility {
        // Universal
        DARKVISION, KNOWLEDGE_FROM_A_PAST_LIFE,
        // Aasimar
        CELESTIAL_RESISTANCE, LIGHT_BEARER, HEALING_HANDS, CELESTIAL_REVELATION,
        // Dragonborn
        DRACONIC_ANCESTRY, BREATH_WEAPON, DRACONIC_FLIGHT,
        // Dwarf
